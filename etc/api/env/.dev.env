# also used as csrf secret key
SECRET_KEY=test
ENV=local

# File Blob storage service
FILE_STORAGE_MEDIA_ROOT=/media/files/
FILE_STORAGE_URL=http://deps-file-storage-nginx:8000
FILE_STORAGE_EXTERNAL_URL=http://localhost:8000/api/storage/v1/file

OBJECT_STORAGE_MODE=sync
OBJECT_STORAGE_TYPE=file-storage

AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_BUCKET_NAME=

GCP_BLOB_STORAGE_BUCKET_NAME=
GCP_BLOB_STORAGE_AUTH_KEY=

# Auth
AUTH_ENABLED=true
# False is solution for self-signed certificate problems
AUTH_VERIFY_SSL=false
# ACCESS_MODE possible values: none, user, role, group, organisation
ACCESS_MODE=organisation
CREATE_ROLE=deps-creator
READ_ROLE=deps-reader
WRITE_ROLE=deps-writer
ADMINS_GROUP=deps-admins
DEFAULT_ORGANISATION=deps-users
API_KEY=134153

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# Kafka
KAFKA_GROUP_ID=documents

# PostgreSQL
DATABASE_HOST=deps-postgres
DATABASE_PORT=5432
DATABASE_DB=deps
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
DATABASE_WORK_USER=deps-postgres
DATABASE_WORK_USER_PASSWORD=deps-postgres-password
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# RabbitMQ
RABBITMQ_HOST=deps-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=deps-rabbitmq
RABBITMQ_DEFAULT_PASS=deps-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=deps
RABBITMQ_USER=deps-rabbitmq
RABBITMQ_PASS=deps-rabbitmq-password
RABBITMQ_VHOST=deps

# Redis
REDIS_HOST=deps-redis
REDIS_PORT=6379
REDIS_DB=0

# Priority (seconds)
PRIORITY_MEDIUM_BOUNDARY=3600
PRIORITY_HIGH_BOUNDARY=10800

# Corleone
CORLEONE_API_HOST=deps-corleone-api
CORLEONE_API_PORT=8000
CORLEONE_API_ENDPOINT=/api/corleone/v1

# Service info
SERVICE_INFO_TAG=latest
SERVICE_INFO_DATE="Tue Aug 17 15:32:31 MSK 2021"
SERVICE_INFO_HASH=b8d6ed5f10

VALIDATION_API_URL=http://deps-validation-api:8000

PARSING_ENABLED=true

AUTO_VALIDATION_ENABLED=false

# Telemetry
INSTRUMENTATION_ENABLED=false
SERVICE_NAME=deps-documents
EXPORTER_TYPE=azure

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string
